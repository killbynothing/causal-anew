{
  "天安门升旗广场": {
    "_note": "LEGACY（2026-07-03 冻结）：逐拍回放管线，不修不删，新能力去 runtime/free_stage_prototype.py；理由见 docs/plans/角色活着_simulation_first_长期计划与工作流重构_2026-07-03.md",
    "blurb": "三月初的清晨，广场上人声鼎沸，国旗在晨光里缓缓升起。",
    "available_exits": [
      {
        "place": "广场旁咖啡厅",
        "route": "shared",
        "scene_id": "OPENING_CAFE_001",
        "ch_anchor": 8,
        "kind": "agenda_soft_exit"
      },
      {
        "place": "王府井街道",
        "route": "shared",
        "scene_id": "OPENING_WANGFUJING_001",
        "ch_anchor": 10,
        "kind": "agenda_soft_exit"
      },
      {
        "place": "北京海族馆",
        "ch_anchor": 10,
        "scene_id": "OPENING_AQUARIUM_001",
        "kind": "agenda_soft_exit",
        "route": "A"
      }
    ],
    "chapters": {
      "8": {
        "present": [
          "C.kakashi.WMAIN",
          "C.xiuzai.WMAIN",
          "C.akito.WMAIN",
          "C.player.WMAIN"
        ],
        "dialogue_flow": [
          {
            "speaker": "老姐/女声",
            "text": "靠，谁叫你偏偏拿着单反！长得高了不起啊，为什么要这么挡住我的视线！",
            "beat_type": "overhear",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "秋人",
            "text": "不行，手冻抖了，抖得厉害，真的没法要了……这下视频真的没法要了啦。",
            "stage": "亮了亮单反，语气懊恼。",
            "beat_type": "overhear",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "老姐/女声",
            "text": "唔，那边的妹子定力不错，拿手机一直录着呢，找她借下视频好了。",
            "beat_type": "overhear",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
            "text": "升旗结束，你收起手机，一转身，三个年轻人正站在你身后。",
            "beat_type": "scene_intro",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "修哉",
            "text": "小姐，那个，你手机不错。圆脸，你问人借东西能不能别像拦路采访。",
            "stage": "他搓着手，先看了看自己的口袋，才把话递出来。",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "能不能不要说这么容易被误会的话？……那个，小姐，不好意思，我表姐真纪个子矮没拍到升旗，你刚才那段视频能不能借我们看一下？",
            "stage": "一边吐槽同伴，一边故作镇定地补救。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          },
          {
            "speaker": "修哉",
            "text": "啧，要么搭把手要么直说不乐意——杵在那儿，问题又不会自己长腿跑了。",
            "stage": "他偏头去催身边的银发青年。",
            "beat_type": "normal",
            "condition": "玩家表示同意、借给他们，或者配合并实质性地接话/回答了关于手机三星像素的问题。",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "视频的事先谢谢你。啊，中文我说得不好。要是听起来唐突，先当成是他太着急了。",
            "stage": "抓了抓头发，语气很轻，视线却一直留意着你手里的手机和周围的人群。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "locked",
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "一起走也行。那个，我们其实是帮我表姐真纪要个清晰的录像，她个子矮没看到，我录的视频手抖糊了。如果可以的话，能不能把刚才的升旗视频传给我们一份？",
            "stage": "搓了搓冻红的双手，露出恳求的表情。",
            "beat_type": "normal",
            "condition": "玩家表示同意、继续，或者询问关于录像/真纪/老姐的问题。",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "你点头了。手冻僵了吗？不如找个暖和点的地方。",
            "stage": "你手一滑，他顺手接住手机，在掌心里转了两圈，又稳稳递回给你。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "不用谢，手机也该还你。那个，其实我叫川口秋人。这两位是坂本晴明和折原修哉。真纪姐要是看到视频，大概会立刻问你在哪儿拍的。",
            "stage": "自我介绍道，顺手指了指身旁的其他两人。",
            "beat_type": "introduce",
            "introduces": [
              "C.akito.WMAIN",
              "C.kakashi.WMAIN",
              "C.xiuzai.WMAIN"
            ],
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "那先找个暖和点的地方吧。真纪姐回消息之前，我们也不能一直站在风里。",
            "stage": "看了眼手机，又朝广场外的人流示意。",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          }
        ],
        "encounters": [
          {
            "beat": "三月初清晨的天安门广场，国歌正压着寒风往上走。你举着手机录升旗，指尖冻得发红，注意力却慢慢从旗杆飘向了身边那些陌生人的说话声。",
            "canon_src": "E008-01",
            "canon_anchor": "OPENING-E008-01"
          }
        ]
      }
    }
  },
  "北京海族馆": {
    "blurb": "幽蓝的光影里，水母在玻璃后慢慢呼吸。",
    "available_exits": [
      {
        "place": "人豚共舞表演区",
        "ch_anchor": 12,
        "route": "A",
        "scene_id": "OPENING_DOLPHIN_001",
        "kind": "agenda_soft_exit"
      }
    ],
    "chapters": {
      "10": {
        "present": [
          "C.kakashi.WMAIN",
          "C.xiuzai.WMAIN",
          "C.akito.WMAIN",
          "C.player.WMAIN"
        ],
        "dialogue_flow": [
          {
            "speaker": "秋人",
            "text": "啊，好巧诶！真没想到这么快又见面了。刚才还没来得及好好道谢呢。",
            "stage": "有些惊喜地打了个招呼。",
            "beat_type": "normal",
            "condition": "玩家到达海族馆、表示认出了他们，或者回应了打招呼。",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "修哉",
            "text": "确实好巧。不过，这地方比广场暖和多了。",
            "stage": "朝你笑了笑，点了点头。",
            "beat_type": "normal",
            "condition": "玩家回应再遇、评论水族馆或温度，或搭话/评论修哉/秋人/话题。",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "看那边的玻璃缸……",
            "stage": "指了指水母缸，若有所思。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          },
          {
            "speaker": "修哉",
            "text": "这个，可以烹来吃掉么？",
            "stage": "看着里面奇怪的水母和清道夫，撑了撑眼镜问。",
            "beat_type": "normal",
            "condition": "玩家对再遇、温度或水族馆表示回应。",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "我不太清楚它的内部构造……不过烤着吃说不定……",
            "stage": "用日语低声和修哉讨论起来，引得秋人直翻白眼。",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "你们两个，在公共场合能不能讨论点正常的食物啊！太丢脸了……",
            "stage": "顺势拍了拍额头，叹了口气。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "但是我还是很想问，为什么这边没有高智商的蛤蟆啊。",
            "stage": "他端着空了的爆米花桶，语气很是遗憾。",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "修哉",
            "text": "你是指会算卦的那种么？那也就只有在 NARUTO 里面有吧。还有啊，会说话的大蛇、不带壳的蜗牛、会说话的猩猩，都是不存在的哟。",
            "stage": "修哉舔了舔手指上的焦糖，斜着眼吐槽。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "其实，给岸本老师当过助手也是真的啦，不过不要说得像我认识真蛤蟆一样啊。",
            "stage": "圆脸青年尴尬地压低帽檐，连忙分辩。",
            "beat_type": "normal",
            "condition": "玩家提到火影、漫画，或者指出秋人是助手/作者相关的话题。",
            "improv": "anchored",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "不过，那个孩子真的好可爱。",
            "stage": "顺着他的视线，水池里的海豚正高高跃起，引来观众的一片掌声。",
            "beat_type": "normal",
            "pause_after": true,
            "improv": "anchored",
            "scene_end": false
          }
        ],
        "encounters": [
          {
            "beat": "光线梦幻的水母缸前，游客如织。那三个人正站在这里，像是顺着今天的行程一路逛到了下一站。",
            "canon_src": "E010-03",
            "canon_anchor": "OPENING-E010-03"
          }
        ]
      }
    }
  },
  "人豚共舞表演区": {
    "blurb": "海豚池上方的大屏幕亮起“今日幸运观众”，光标在人群里扫来扫去。",
    "scene_id": "OPENING_DOLPHIN_001",
    "available_exits": [
      {
        "place": "街角咖啡厅",
        "route": "A",
        "scene_id": "OPENING_SHOOTING_001",
        "ch_anchor": 13,
        "kind": "agenda_soft_exit"
      }
    ],
    "chapters": {
      "12": {
        "present": [
          "C.kakashi.WMAIN",
          "C.xiuzai.WMAIN",
          "C.akito.WMAIN",
          "C.player.WMAIN"
        ],
        "dialogue_flow": [
          {
            "speaker": "导演",
            "text": "大屏幕打出『今日幸运观众』光标框住你们，伴奏响起。",
            "stage": "光标在人群中扫来扫去，最后定格。",
            "beat_type": "scene_intro",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false
          },
          {
            "speaker": "导演",
            "text": "饲养员招手：『请这几位上来，跟我们的明星海豚来一段——人豚共舞！』",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "修哉",
            "text": "我问过饲养员了，貌似就是我们跳一个扭扭体操的话，海豚也会跟着一起跳……",
            "stage": "压低声音解释。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "你们两个像接头暗号的动作是搞什么啊！又不是在做任务说什么耳语啊！",
            "stage": "压低声音吐槽。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "导演",
            "text": "主持人宣布正式开始，卡卡西被选上台，眼睛亮起来，大幅度扭动，越扭越卖力，浑然忘我。秋人被一把拽过来，身体僵硬地跟着扭。修哉边吃爆米花边配合。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
            "text": "海豚发出尖锐的叫声，浮出水面，靠着尾巴的力气摆动着身子，引来全场哄笑与掌声。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
            "text": "眼前这一幕——银发青年忘我热舞，海豚配合尖叫，三人狼狈却默契——你不由自主地举起手机，把这幕录了下来。",
            "beat_type": "player_choice",
            "improv": "free",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
            "text": "录像上传爆红，没人会想到，在某条转发的评论区里，有人盯着画面角落那张银发的侧脸，沉默了很久。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": true,
            "stage": "-"
          }
        ],
        "encounters": [
          {
            "beat": "海豚池上方的大屏幕亮起“今日幸运观众”，你们这一片被框住了。",
            "canon_src": "E012-01",
            "canon_anchor": "OPENING-E012-01"
          }
        ]
      }
    }
  },
  "王府井街道": {
    "blurb": "王府井的人潮从商场门口往外涌，真纪约好的会合点却迟迟没有人影。这更像一个短暂停靠的岔口，而不是能一直站着等人的地方。",
    "available_exits": [
      {
        "place": "北京海族馆",
        "route": "A",
        "scene_id": "OPENING_AQUARIUM_001",
        "ch_anchor": 10,
        "kind": "agenda_soft_exit"
      },
      {
        "place": "天津·真纪家见张尘",
        "route": "B",
        "scene_id": "OPENING_TIANJIN_ZHANGCHEN_001",
        "ch_anchor": 15,
        "kind": "agenda_soft_exit"
