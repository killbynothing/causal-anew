        "dialogue_flow": [
          {
            "speaker": "导演",
            "text": "天津站。傍晚。人群匇匇。秋人拎着单反，真纪提着行李，两人从出站口涌出的人流中挤出来。",
            "stage": "天津站出口",
            "beat_type": "scene_intro",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "比开车那两位快多了……也不知道他们到哪了。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "导演",
            "text": "真纪家的门打开，刘云天迎出来。客厅里还有一个人——坐在沙发上，穿着普通的青年。",
            "stage": "真纪家客厅",
            "beat_type": "scene_intro",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "刘云天",
            "text": "这位是小初的同事，张尘。来帮忙的。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "张尘",
            "text": "请多指教，我是张尘。初姐让我先过来看看，有什么事随时说。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "玩家",
            "text": "",
            "stage": "-",
            "beat_type": "player_choice",
            "improv": "free",
            "condition": "玩家第一次见张尘",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "真纪",
            "text": "云天，医院那边我要去，张尘你先——",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "张尘",
            "text": "初姐说了，她去医院，让我在家这边待命。你们要去的话，我可以开车送。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "anchored",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "导演",
            "text": "电话铃声突然响起。魏初的声音从免提里传出。",
