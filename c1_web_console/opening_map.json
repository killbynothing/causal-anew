        "present": [
          "C.player.WMAIN",
          "C.kakashi.WMAIN",
          "C.xiuzai.WMAIN",
          "C.akito.WMAIN"
        ],
        "dialogue_flow": [
          {
            "speaker": "修哉",
            "text": "我敢保证真纪姐又把“马上到”说成了一个很宽泛的概念。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "修哉",
            "text": "阿哈，那就别站在这里给人潮当路障。她要是真到了，自然会打电话骂秋人，我们先离开这个会合点。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "秋人",
            "text": "那总得先动起来吧？真纪姐要追人，总比在这条街上捞针容易。",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "卡卡西",
            "text": "海族馆？",
            "stage": "-",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "玩家",
            "text": "",
            "stage": "-",
            "beat_type": "player_choice",
            "improv": "free",
            "pause_after": true,
            "scene_end": false
          },
          {
            "speaker": "导演",
            "text": "真纪的电话仍旧没有打来。王府井的人潮把等待冲得越来越散，继续站在这里已经没有意义，只能先离开这个会合点。",
            "stage": "离开王府井会合点",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "auto_transition": true
          }
        ]
      }
    },
    "scene_id": "OPENING_WANGFUJING_001"
  },
  "中心医院合流": {
    "blurb": "急救室的灯亮着，走廊里三拨人几乎同时赶到。",
    "scene_id": "OPENING_HOSPITAL_001",
    "available_exits": [],
    "chapters": {
      "16": {
        "present": [
          "C.xiuzai.WMAIN",
          "C.maki.WMAIN",
          "C.zhangchen.WMAIN",
          "C.weichu.WMAIN",
          "C.player.WMAIN"
        ],
        "dialogue_flow": [
          {
            "speaker": "导演",
            "text": "急救室的灯亮着，走廊里弥漫着消毒水的气味。你跟着担架一路跑到这里，看见银发青年被推进手术室。",
            "beat_type": "scene_intro",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "真纪",
            "text": "不会吧？不会出事对吧。不会出事对不对？",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "真纪",
            "text": "修哉！",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "真纪",
            "text": "阿修阿修，太好了还活着。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "真纪",
            "text": "阿修，你没事么？头很疼么，严重么？医生怎么说？",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": false,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
            "text": "修哉躺在病床上，手臂缠着绷带。真纪抱住了他，手在发抖。",
            "beat_type": "normal",
            "improv": "locked",
            "pause_after": true,
            "scene_end": false,
            "stage": "-"
          },
          {
            "speaker": "导演",
