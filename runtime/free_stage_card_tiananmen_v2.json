{
  "scene": "天安门广场",
  "scene_id": "OPENING_TIANANMEN_002",
  "ch_anchor": 8,
  "clock": "06:10",
  "entry_hook": "天还没有完全亮，风从长安街直灌过来。广场上黑压压全是人，呼出的白气一层层浮在灯下；国歌刚刚压着寒风走完，冷意先落在脸上，再慢慢往手指上爬。升旗结束后，人群开始松动散开。",
  "blurb": "红旗仍在旗杆顶端舒展。散场的人声刚起又落，不远处忽然飘来几句听不太分明的争论，语气不像真吵，更像是用一种你不太熟的语言在互相嫌弃。",
  "present": [
    "C.maki.WMAIN",
    "C.kakashi.WMAIN",
    "C.xiuzai.WMAIN",
    "C.akito.WMAIN"
  ],
  "current_event_terms": [
    "升旗散场",
    "单反",
    "初遇"
  ],
  "scene_frame": {
    "where": "北京天安门广场升旗区旁",
    "when": "三月初的清晨，升旗仪式刚刚结束"
  },
  "memory_layers": {
    "context_memory": [
      "升旗仪式刚刚在这个冷天里结束；是否录到视频、有没有拿手机，必须以现场实际陈述为准。",
      "真纪起初与三人同在升旗区，随后为补拍升旗手先离开；玩家面前只剩秋人、修哉和晴明。",
      "三人彼此说日语；与玩家的沟通桥梁是秋人发现这个人听得懂之后切换的中文。",
      "单反带子差点蹭到玩家胳膊，秋人本能用日语道歉——这是搭话的由头，不是事先准备好的借视频开场白。"
    ],
    "relationship_memory": [
      "这是第一次照面，还没有深层信任；能开口，是因为语言通了，不是因为谁欠谁人情。",
      "借视频是聊起来之后才提出的请求，可以答应也可以说没录到；这个人必须接住，不得反复索取。"
    ],
    "knowledge_gate": [
      "当前时间节点为Ch8升旗广场刚结束的清风冷天。",
      "只有玩家主动提起《火影忍者》时，才可以顺着动漫话题聊；不得把它写成固定节拍。",
      "【自然不谈】枪击、逃亡、组织背景、龙也托付、挂坠用途。",
      "角色不知道玩家与龙也的私交；不得主动提起龙也、托付或挂坠。"
    ]
  },
