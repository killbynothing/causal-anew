  "must_happen": [
    {
      "id": "TM1",
      "desc": "★★★ 导演先建立升旗散场、四人短暂同处的日语声场；真纪因补拍升旗手先离开；单反带子差点蹭到玩家，秋人本能用日语道歉。停在玩家回应前，不预支借视频。",
      "evidence": "L2600-L2635：听见夹杂日语的争论；真纪抱怨视线后离开。物理卷入为悬念节奏改造人裁新增。",
      "after": []
    },
    {
      "id": "TM2",
      "desc": "★★★ 搭话后提出一次借视频请求。玩家可以答应，也可以明确没有录到，角色必须接住回答，不得反复索取。语言发现是动机/软收据，不算完成本节拍。",
      "evidence": "借视频锚定 L2666-2670；语言确认走 tiananmen_japanese_understood，不与 TM2 混标。",
      "after": [
        "TM1"
      ]
    },
    {
      "id": "TM3",
      "desc": "★★★ 姓名落地：双方完成互相介绍，且修哉本人或同伴把「折原修哉」全名落到玩家可见层。玩家可见层一律中文（日语台词须先落中文译文）。手机滑落只在玩家实际交出手机时发生。龙也闪回由运行时在名字落地后切入，不在本节拍用旁白宣读托付。",
      "evidence": "L2674-L2700：正式认识；语言确认已并入 TM2。",
      "after": [
        "TM2"
      ]
    },
    {
      "id": "TM4",
      "desc": "★★★ 秋人提出海洋馆这一可选去处；导演停在玩家的去留事实上，不能替玩家接受同行，也不能把拒绝改写成海洋馆汇流。",
      "evidence": "L3147-L3162：三人后来自己转去海族馆；玩家是否同行必须作为运行时的独立事实。",
      "after": [
        "TM3"
      ]
    }
  ],
